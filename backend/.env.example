PORT=2012

# Logging — path relative to the app root or absolute
# LOG_DIR=./logs
# LOG_DIR=/var/log/velomate
LOG_LEVEL=info
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Timezone override — only needed if the system timezone is wrong.
# The app reads the system timezone automatically via Intl.DateTimeFormat.
# On a Pi, configure once with: sudo timedatectl set-timezone Europe/Amsterdam
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# USER_TIMEZONE=Europe/Amsterdam

# ── Test runner (npm run test) ────────────────────────────────────────────────
# Required to run the athlete plan simulator. Independent from the app config.
# TEST_GEMINI_KEY=your_api_key_here
# TEST_GEMINI_MODEL=gemini-3.6-flash
